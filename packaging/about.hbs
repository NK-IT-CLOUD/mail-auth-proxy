<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>mail-auth-proxy: third-party licenses</title>
<style>
body { font-family: sans-serif; max-width: 60rem; margin: 0 auto; padding: 1rem; }
pre { white-space: pre-wrap; background: #f4f4f4; padding: 0.5rem; }
@media (prefers-color-scheme: dark) { body { background: #222; color: #ddd; } pre { background: #333; } a { color: #8cf; } }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>mail-auth-proxy is MIT-licensed. The binary contains the following Rust crates,
used under the licenses below.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
{{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}{{#if crate.repository}} (<a href="{{crate.repository}}">{{crate.repository}}</a>){{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
