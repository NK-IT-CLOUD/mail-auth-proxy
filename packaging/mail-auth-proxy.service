[Unit]
Description=mail-auth-proxy (IMAP, SMTP submission and ManageSieve authentication proxy)
After=network-online.target
Wants=network-online.target

[Service]
# The proxy sends READY=1 once the JWKS are loaded and every listener is bound,
# and STOPPING=1 on shutdown (from the main process: NotifyAccess=main).
Type=notify
ExecStart=/usr/bin/mail-auth-proxy /etc/mail-auth-proxy/config.toml
# SIGHUP: reload the config file (listener and metrics addresses need a
# restart), the TLS certificates and the JWKS; open connections stay
ExecReload=/bin/kill -HUP $MAINPID
Environment=RUST_LOG=info
# Unprivileged system user from sysusers.d; its group owns the config and the TLS
# key (root:mail-auth-proxy 0640).
User=mail-auth-proxy
Group=mail-auth-proxy
# No System V IPC objects or POSIX shared memory outlive the service.
RemoveIPC=yes
# Only capability needed: bind the privileged ports 993 and 587
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Sandbox
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A blocked syscall fails with EPERM instead of killing the process.
SystemCallErrorNumber=EPERM
UMask=0077
Restart=on-failure
RestartSec=2
# Each session holds two sockets; max_connections (default 2048) must fit.
LimitNOFILE=16384
# No core dumps (soft and hard limit): they could hold tokens and the TLS key.
LimitCORE=0

[Install]
WantedBy=multi-user.target
